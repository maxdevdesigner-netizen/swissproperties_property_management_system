# Copy to .env and fill in. Never commit .env.

# Local dev: run `npx prisma dev` and paste the TCP postgres:// URL it prints.
# Production: the DATABASE_URL from the live server's .env (test against a COPY first).
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Login created by `npm run db:seed` (local dev only).
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="change-me-locally"
