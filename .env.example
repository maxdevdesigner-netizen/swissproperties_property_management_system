# Copy to .env and fill in. Never commit .env.

# Local dev: run `npx prisma dev` and paste the TCP postgres:// URL it prints.
# Production: the DATABASE_URL from the live server's .env (test against a COPY first).
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Login created by `npm run db:seed` (local dev only).
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="change-me-locally"

# Shared secret for POST /api/cron/notifications (optional scheduled job).
CRON_SECRET=""

# Uploaded files (property pictures, Emirates ID copies). In production, a folder OUTSIDE the app,
# e.g. /var/lib/swiss-pms/uploads, holding the files copied from the live server.
UPLOADS_DIR="./uploads"

# Email (password-reset links, payment reminders). Leave SMTP_HOST empty to turn email off.
SMTP_HOST=""
SMTP_PORT="587"
# "true" for port 465; otherwise STARTTLS is used when the server offers it.
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Swiss Properties <no-reply@swissproperties.xyz>"
