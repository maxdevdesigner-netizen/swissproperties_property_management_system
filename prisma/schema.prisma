// Reconstructed from the live swissproperties.xyz API responses (see docs/REBUILD_SPEC.md).
// Field names match the live app so this schema can be compared with `prisma db pull`
// against a copy of the production database before it is ever pointed at real data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum Brand {
  SWISS_PROPERTIES
  SWISS_HOMES
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  STUDIO
  PENTHOUSE
  DUPLEX
  LOFT
  HOTEL_APARTMENT
  OFFICE
  RETAIL
  WAREHOUSE
  MIXED_USE
  LAND
}

enum UnitType {
  STUDIO
  ONE_BR
  TWO_BR
  THREE_BR
  FOUR_BR
  PENTHOUSE
  OFFICE
  RETAIL
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  STRIPE
  OTHER
}

enum NotificationType {
  PAYMENT_OVERDUE
  PAYMENT_RECEIVED
  LEASE_EXPIRING
  MAINTENANCE
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  VIEW
  BULK_RENEW
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  password      String
  role          Role           @default(STAFF)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  auditLogs     AuditLog[]
}

model Property {
  id          String       @id @default(cuid())
  name        String
  street      String
  city        String
  emirate     String
  zip         String
  country     String       @default("United Arab Emirates")
  description String?
  type        PropertyType @default(APARTMENT)
  brand       Brand        @default(SWISS_PROPERTIES)
  images      String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  units       Unit[]

  @@index([brand])
}

model Unit {
  id           String     @id @default(cuid())
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitNumber   String
  floor        Int?
  type         UnitType   @default(STUDIO)
  sizeSqm      Decimal?   @db.Decimal(10, 2)
  rentAmount   Decimal    @db.Decimal(12, 2)
  status       UnitStatus @default(VACANT)
  description  String?
  listingNotes String?
  listingPrice Decimal?   @db.Decimal(12, 2)
  vacantSince  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  leases       Lease[]

  @@unique([propertyId, unitNumber])
}

model Tenant {
  id               String    @id @default(cuid())
  brand            Brand     @default(SWISS_PROPERTIES)
  firstName        String
  lastName         String
  email            String?
  phone            String?
  dateOfBirth      DateTime?
  nationalId       String?
  nationality      String?
  emiratesId       String?
  emiratesIdCopy   String?
  emergencyContact String?
  notes            String?
  // Tenant portal login. Hashed, and never selected into anything sent to the browser.
  portalPassword   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  leases           Lease[]

  @@index([brand])
}

model Lease {
  id                  String      @id @default(cuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unitId              String
  unit                Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  startDate           DateTime
  endDate             DateTime?
  rentAmount          Decimal     @db.Decimal(12, 2)
  depositAmount       Decimal?    @db.Decimal(12, 2)
  depositPaid         Boolean     @default(false)
  status              LeaseStatus @default(ACTIVE)
  lateFeeGraceDays    Int         @default(5)
  lateFeePercent      Decimal?    @db.Decimal(5, 2)
  vatRate             Decimal     @default(0) @db.Decimal(4, 3)
  installmentsPerYear Int         @default(12)
  agentName           String?
  agentContact        String?
  commissionRate      Decimal?    @db.Decimal(5, 2)
  commissionAmount    Decimal?    @db.Decimal(12, 2)
  commissionPaid      Boolean     @default(false)
  commissionPaidDate  DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  payments            Payment[]

  @@index([status])
}

model Payment {
  id                 String         @id @default(cuid())
  leaseId            String
  lease              Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  amount             Decimal        @db.Decimal(12, 2)
  amountPaid         Decimal        @default(0) @db.Decimal(12, 2)
  dueDate            DateTime
  paidDate           DateTime?
  status             PaymentStatus  @default(PENDING)
  method             PaymentMethod?
  notes              String?
  receiptNumber      String?        @unique
  receiptGeneratedAt DateTime?
  reminderSentAt     DateTime?
  dunningStage       Int            @default(0)
  stripeSessionId    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([dueDate])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stops the scheduled job from creating the same alert twice.
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  entity    String
  entityId  String?
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  details   Json?
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([entity])
}
